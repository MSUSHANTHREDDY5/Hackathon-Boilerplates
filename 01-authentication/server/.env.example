# Server Port (5001 avoids macOS AirPlay ControlCenter port 5000 conflict)
PORT=5001

# Database Configuration
MONGO_URI=mongodb://127.0.0.1:27017/hackathon_auth_db

# JWT Configuration (REQUIRED - Must not be empty)
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# Cookie Security Configuration
# COOKIE_SECURE: true | false (default: true in production, false in development)
COOKIE_SECURE=false

# COOKIE_SAMESITE: lax | strict | none (default: lax)
# Note: If COOKIE_SAMESITE is set to 'none', COOKIE_SECURE is automatically forced to true.
COOKIE_SAMESITE=lax

# Frontend Application URL (for CORS)
CLIENT_URL=http://localhost:5173

# Node Environment (development | production)
NODE_ENV=development
