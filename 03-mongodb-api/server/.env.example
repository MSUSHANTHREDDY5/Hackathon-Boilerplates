# Server Port
PORT=5003

# MongoDB Connection String (Local development string by default)
# Note: For hackathons using MongoDB Atlas, replace this URI with:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/hackathon_db
MONGODB_URI=mongodb://127.0.0.1:27017/hackathon_db

# Frontend Application URL (for CORS)
CLIENT_URL=http://localhost:5175

# Node Environment (development | production)
NODE_ENV=development
